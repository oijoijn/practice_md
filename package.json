{
  "name": "md-to-html-server",
  "version": "0.1.0",
  "description": "ローカル Markdown プレビューサーバー",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "mime-types": "^2.1.35",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.4",
    "@vitest/coverage-v8": "^1.0.0",
    "fast-check": "^3.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
